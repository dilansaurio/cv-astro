---
import { getTranslation, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<div class="col-span-1 bg-background-card p-5 sm:p-6 rounded-3xl border border-border flex flex-col bento-card">
  <h2 class="text-lg font-bold text-text leading-tight mb-1 flex items-center justify-center gap-2 pb-3">
    <iconify-icon icon="mdi:school" class="text-primary" width="22" height="22"></iconify-icon>
    {getTranslation(lang, 'education.title')}
  </h2>

  <div class="bg-background rounded-2xl px-4 py-4">
    <ul class="w-full flex flex-col gap-2">
      <li class="flex items-start gap-2 text-text-muted text-sm 2xl:text-md">
        <span class="text-primary mt-0.5 shrink-0">-</span>
        {getTranslation(lang, 'education.cert1')}
      </li>
      <li class="flex items-start gap-2 text-text-muted text-sm 2xl:text-md">
        <span class="text-primary mt-0.5 shrink-0">-</span>
        {getTranslation(lang, 'education.cert2')}
      </li>
    </ul>
  </div>
</div>
