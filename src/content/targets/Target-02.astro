---
import { getTranslation, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const skills = [
  {
    categoryKey: 'skills.development',
    category: getTranslation(lang, 'skills.development'),
    items: [
      { name: 'React', icon: 'logos:react' },
      { name: 'React Native', icon: 'logos:react' },
      { name: 'Astro', icon: 'logos:astro-icon', class: 'dark:invert' },
      { name: 'TypeScript', icon: 'logos:typescript-icon' },
      { name: 'JavaScript', icon: 'logos:javascript' },
      { name: 'Tailwind CSS', icon: 'logos:tailwindcss-icon' },
      { name: 'Next.js', icon: 'logos:nextjs-icon' },
      { name: 'shadcn/ui', icon: 'simple-icons:shadcn-ui' },
    ],
  },
  {
    categoryKey: 'skills.design',
    category: getTranslation(lang, 'skills.design'),
    items: [
      { name: 'Figma', icon: 'logos:figma' },
      { name: 'Photoshop', icon: 'logos:adobe-photoshop' },
      { name: 'Illustrator', icon: 'logos:adobe-illustrator' },
      { name: 'After Effects', icon: 'logos:adobe-after-effects' },
    ],
  },
  {
    categoryKey: 'skills.collaboration',
    category: getTranslation(lang, 'skills.collaboration'),
    items: [
      { name: 'Git', icon: 'logos:git' },
      { name: 'GitHub', icon: 'logos:github' },
      { name: 'Bitbucket', icon: 'logos:bitbucket' },
    ],
  },
];

---
<div class="col-span-1 sm:col-span-1 lg:col-span-1 min-w-0 h-full bg-background-card p-2.5 rounded-3xl border border-border text-text flex flex-col gap-1.5 bento-card animate-fade-up delay-3">
  <h2 class="title-section text-xs">
    <iconify-icon icon="mdi:lightning-bolt" class="text-primary" width="16" height="16"></iconify-icon>
    {getTranslation(lang, 'skills.title')}
  </h2>

  <div class="grid grid-cols-1 auto-rows-max content-start gap-1.5">
    {skills.map(({ category, categoryKey, items }) => (
      <div class="grid min-w-0 grid-cols-1 sm:grid-cols-[minmax(6rem,0.8fr)_1.2fr] items-center bg-background rounded-2xl px-2.5 py-2 gap-2">
        <span class="text-[11px] text-center sm:text-left font-semibold leading-tight text-text" data-i18n={categoryKey}>{category}</span>
        <div class="flex items-center gap-1 flex-wrap">
          {items.map(({ name, icon, class: iconClass }) => (
            <span class="flex min-w-0 items-center gap-1.5 px-2 py-1 rounded-full border border-border bg-background-card text-text text-[10px] font-medium leading-tight">
              {icon && <iconify-icon icon={icon} width="18" height="18" class={iconClass}></iconify-icon>}
              <span>{name}</span>
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>