---
import { getTranslation, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<div class="min-w-0 h-full bg-background-card p-3 sm:p-4 lg:p-5 rounded-3xl border border-border flex flex-col justify-center bento-card lg:min-h-0">
  <div class="flex items-start justify-between gap-2">
    <h1 class="text-lg sm:text-xl 2xl:text-xl font-bold text-text leading-tight flex items-center gap-1.5">
      <iconify-icon icon="mdi:hand-wave" class="text-primary animate-wiggle" width="24" height="24"></iconify-icon>
      {getTranslation(lang, 'hero.greeting')}
    </h1>
    <!-- <div class="flex gap-1 shrink-0">
      <a href="https://github.com/dilansaurio" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <iconify-icon icon="mdi:github" width="24" height="24" class="text-primary hover:text-primary-dark transition-colors"></iconify-icon>
      </a>
      <a href="https://linkedin.com/in/dilansilvacortes" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <iconify-icon icon="mdi:linkedin" width="24" height="24" class="text-primary hover:text-primary-dark transition-colors"></iconify-icon>
      </a>
    </div> -->
  </div>
  <p class="mt-1 text-sm lg:text-base font-semibold text-primary">
    {getTranslation(lang, 'hero.role')}
  </p>
  <p class="mt-2 text-xs sm:text-sm leading-relaxed text-text-muted">
    {getTranslation(lang, 'hero.description')}
  </p>
</div>