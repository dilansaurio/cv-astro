---
import { getTranslation, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<div class="bg-background-card p-5 sm:p-6 lg:p-8 rounded-3xl border border-border flex flex-col justify-center bento-card">
  <div class="flex items-start justify-between gap-2">
    <h1 class="text-xl sm:text-2xl 2xl:text-2xl font-bold text-text leading-tight flex items-center gap-2">
      <iconify-icon icon="mdi:hand-wave" class="text-primary animate-wiggle" width="28" height="28"></iconify-icon>
      {getTranslation(lang, 'hero.greeting')}
    </h1>
    <div class="flex gap-1 shrink-0">
      <a href="https://github.com/dilansaurio" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <iconify-icon icon="mdi:github" width="28" height="28" class="text-primary hover:text-primary-dark transition-colors"></iconify-icon>
      </a>
      <a href="https://linkedin.com/in/dilansilvacortes" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <iconify-icon icon="mdi:linkedin" width="28" height="28" class="text-primary hover:text-primary-dark transition-colors"></iconify-icon>
      </a>
    </div>
  </div>
  <p class="mt-1 text-base lg:text-lg font-semibold text-primary">
    {getTranslation(lang, 'hero.role')}
  </p>
  <p class="mt-4 text-text-muted text-sm 2xl:text-md leading-relaxed">
    {getTranslation(lang, 'hero.description')}
  </p>
</div>