---
import { getTranslation, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<div class="col-span-1 bg-primary p-5 sm:p-6 lg:p-8 rounded-3xl text-white flex flex-col justify-between hover:bg-primary-dark transition-colors group relative min-h-50">
  <h2 class="text-base font-semibold flex items-center justify-center gap-2">
    <iconify-icon icon="mdi:file-download" width="20" height="20"></iconify-icon>
    {getTranslation(lang, 'contact.downloadCV')}
  </h2>
  <span class="text-5xl group-hover:translate-x-1 transition-transform">→</span>
  <a
    href="/files/CV_Dilan_Silva_Cortes.pdf"
    download="CV_Dilan_Silva_Cortes.pdf"
    class="absolute inset-0"
    aria-label={getTranslation(lang, 'contact.downloadCV')}
  ></a>
</div>