---
import { getTranslation, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<div class="col-span-1 bg-background-card p-3 sm:p-4 rounded-3xl border border-border flex flex-col justify-between min-h-50 bento-card">
  <div>
    <h2 class="justify-center text-base font-bold text-text leading-tight flex items-center gap-2 pt-0" data-i18n="contact.title">
      <iconify-icon icon="mdi:handshake" class="text-primary" width="20" height="20"></iconify-icon>
      {getTranslation(lang, 'contact.title')}
    </h2>
    <p class="text-text-muted text-xs mt-2 leading-relaxed" data-i18n="contact.description">
      {getTranslation(lang, 'contact.description')}
    </p>
  </div>
  <div class="flex flex-col gap-1.5 mt-3">
    <a
      href="/files/CV_Dilan_Silva_Cortes.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 w-full px-4 py-2 rounded-xl bg-primary text-white text-sm font-semibold hover:bg-primary-dark transition-colors"
      data-i18n="contact.downloadCV"
    >
      <iconify-icon icon="mdi:file-download" width="16" height="16"></iconify-icon>
      {getTranslation(lang, 'contact.downloadCV')}
    </a>
    <a
      href="mailto:dilans.matias26@gmail.com"
      class="flex items-center justify-center gap-2 w-full px-4 py-2 rounded-xl border border-border text-text text-sm font-semibold hover:bg-background transition-colors"
      data-i18n="contact.sendEmail"
    >
      <iconify-icon icon="mdi:email-outline" width="16" height="16"></iconify-icon>
      {getTranslation(lang, 'contact.sendEmail')}
    </a>
  </div>
</div> 
