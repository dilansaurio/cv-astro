---
import type { CollectionEntry } from 'astro:content';
import { getTranslation, type Language } from '../../i18n/utils';
import ProjectsModal from '../../components/interactive/ProjectsModal';

interface Props {
  proyectos: CollectionEntry<'proyectos'>[];
  lang: Language;
}
const { proyectos, lang } = Astro.props;

const projectsData = proyectos.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  image: p.data.image,
  technologies: p.data.technologies,
  link: p.data.link,
  category: p.data.category,
}));
---

<div class="col-span-1 h-[545px] max-h-[545px] bg-background-card p-5 sm:p-6 rounded-3xl border border-border flex flex-col bento-card animate-fade-up delay-4 overflow-hidden">
  <!-- Flex-shrink-0 evita que el encabezado se colapse -->
  <h2 class="title-section flex-shrink-0">
    <iconify-icon icon="mdi:folder-multiple" class="text-primary" width="22" height="22"></iconify-icon>
    {getTranslation(lang, 'projects.title')}
  </h2>
  
  <!-- min-h-0 permite flex shrinkage dentro de la tarjeta -->
  <div class="relative flex-1 min-h-0 mt-4 overflow-hidden rounded-2xl">
    <!-- Grid adaptativo con degradado suave en la parte inferior -->
    <div class="grid grid-cols-2 gap-2 opacity-40 blur-[1px] pointer-events-none select-none h-full overflow-hidden [mask-image:linear-gradient(to_bottom,black_50%,transparent)]">
      {proyectos.map((p) => (
        <div class="flex flex-col rounded-xl overflow-hidden border border-border bg-background h-fit">
          <div class="aspect-video w-full overflow-hidden flex-shrink-0">
            <img
              src={p.data.image}
              alt={p.data.title}
              width="200"
              height="113"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="p-2 flex flex-col gap-1 min-w-0">
            <span class="text-xs font-semibold text-text leading-tight truncate">{p.data.title}</span>
            {p.data.technologies && p.data.technologies.length > 0 && (
              <div class="flex flex-wrap gap-1 max-h-8 overflow-hidden">
                {p.data.technologies.map((tech) => (
                  <span class="text-[9px] px-1.5 py-0.5 rounded-full bg-primary/10 text-primary font-medium leading-none whitespace-nowrap">
                    {tech}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
      {proyectos.length === 0 && (
        <p class="col-span-2 text-text-muted text-xs text-center py-4">{getTranslation(lang, 'projects.comingSoon')}</p>
      )}
    </div>

    <!-- Modal centrado en primer plano -->
    <div class="absolute inset-0 flex items-center justify-center z-10">
      <ProjectsModal projects={projectsData} client:load />
    </div>
  </div>
</div>