---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
interface Props {
	title: string;
}
const { title } = Astro.props;
import i18nScript from '../scripts/i18n.js?raw';
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/png" href="/image/avatar.png" />
		<title>{title}</title>
		<script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
		<script is:inline>
			// Prevent flash: apply dark class before paint (only on client)
			if (typeof localStorage !== 'undefined') {
				(function() {
					const saved = localStorage.getItem('theme');
					if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
						document.documentElement.classList.add('dark');
					}
				})();
			}
			// Initialize language
			if (typeof localStorage !== 'undefined') {
				const lang = localStorage.getItem('lang') || 'es';
				document.documentElement.setAttribute('lang', lang);
				document.documentElement.setAttribute('data-lang', lang);
			}
		</script>
		<script type="module" is:inline set:html={i18nScript}></script>
		<ClientRouter />
	<body>
		<slot />
	</body>
</html>